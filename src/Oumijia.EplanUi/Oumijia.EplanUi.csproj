<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Oumijia.EplanUi</RootNamespace>
    <AssemblyName>Oumijia.EplanUi</AssemblyName>
    <Version>0.5.2</Version>
    <Authors>wuwenhou</Authors>
    <Company>Tool Oumijia</Company>
    <Product>Tool Oumijia (EPLAN)</Product>
    <Description>Shared EPLAN forms and UI implementation used by both Tool Oumijia editions.</Description>
    <RepositoryUrl>https://github.com/wuwenhou/Tool-Oumijia-EPLAN</RepositoryUrl>
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <EplanApiDir Condition="'$(EplanApiDir)' == ''">$(EPLAN_API_DIR)</EplanApiDir>
    <EplanApiDir Condition="'$(EplanApiDir)' == '' And Exists('C:\Program Files\EPLAN\Platform\2022.0.3\Bin\Eplan.EplApi.AFu.dll')">C:\Program Files\EPLAN\Platform\2022.0.3\Bin</EplanApiDir>
  </PropertyGroup>

  <Target Name="FailWhenEplanApiMissing" BeforeTargets="BeforeCompile"
          Condition="'$(EplanApiDir)' == '' Or !Exists('$(EplanApiDir)\Eplan.EplApi.MasterDatau.dll')">
    <Error Code="OUMIJIA001"
           Text="EPLAN API assemblies not found. Build with -p:EplanApiDir=&quot;C:\Program Files\EPLAN\Platform\&lt;version&gt;\Bin&quot; — see docs/BUILD.md." />
  </Target>

  <ItemGroup Condition="'$(EplanApiDir)' != '' And Exists('$(EplanApiDir)\Eplan.EplApi.MasterDatau.dll')">
    <Reference Include="Eplan.EplApi.AFu">
      <HintPath>$(EplanApiDir)\Eplan.EplApi.AFu.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.Baseu">
      <HintPath>$(EplanApiDir)\Eplan.EplApi.Baseu.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.Guiu">
      <HintPath>$(EplanApiDir)\Eplan.EplApi.Guiu.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.MasterDatau">
      <HintPath>$(EplanApiDir)\Eplan.EplApi.MasterDatau.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Oumijia.EdzReader\Oumijia.EdzReader.csproj" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
