<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <EplanTargetFramework Condition="'$(EplanTargetFramework)' == ''">net48</EplanTargetFramework>
    <TargetFramework>$(EplanTargetFramework)</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Oumijia.EdzReader</RootNamespace>
    <AssemblyName>Oumijia.EdzReader</AssemblyName>
    <Version>0.7.0</Version>
    <Authors>wuwenhou</Authors>
    <Company>Tool Oumijia</Company>
    <Product>Tool Oumijia (EPLAN)</Product>
    <Description>Local reader for factual EDZ package metadata used by Tool Oumijia.</Description>
    <RepositoryUrl>https://github.com/wuwenhou/Tool-Oumijia-EPLAN</RepositoryUrl>
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.2" />
    <!-- Match the assembly versions referenced by SharpCompress 0.50.2's net48 binary. -->
    <PackageReference Include="System.Buffers" Version="4.6.1" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
