<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tool Oumijia — EPLAN Data Portal host.

    This project contains the shared WinForms + WebView2 dialog used by:
      - the EPLAN add-in (Oumijia.EplAddin.EDZ.dll), referenced as a project;
      - the Script Edition, loaded at runtime with Assembly.LoadFrom.

    Why a separate assembly?
      EPLAN's Script Edition is compiled by EPLAN's own C# 5 compiler and cannot
      reference the WebView2 SDK at compile time. Keeping the browser UI here lets
      both editions share exactly the same implementation.

    Build:
      dotnet build src/Oumijia.PortalHost/Oumijia.PortalHost.csproj -c Release
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Oumijia.PortalHost</RootNamespace>
    <AssemblyName>Oumijia.PortalHost</AssemblyName>
    <Version>0.5.2</Version>
    <Authors>wuwenhou</Authors>
    <Company>Tool Oumijia</Company>
    <Product>Tool Oumijia (EPLAN)</Product>
    <Description>Embedded EPLAN Data Portal (WebView2) for Tool Oumijia.</Description>
    <RepositoryUrl>https://github.com/wuwenhou/Tool-Oumijia-EPLAN</RepositoryUrl>
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3351.48" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
